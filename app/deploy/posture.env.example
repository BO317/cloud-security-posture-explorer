# Optional legacy/local fallback only. EC2 can run without this file using SSM + IMDSv2.
# Replace these invented identifiers with explicit personal-lab resources.
# Do not put credentials here. At least one resource list must be nonempty.
AWS_REGION=us-east-1
ALLOWED_BUCKETS=replace-with-your-lab-bucket
ALLOWED_SECURITY_GROUPS=sg-0123456789abcdef0
# Optional: comma-separated literal EC2 Name tag values for attached EBS encryption checks.
# Example: ALLOWED_INSTANCE_NAME_TAGS=cloud-security-posture-explorer
ALLOWED_INSTANCE_NAME_TAGS=
# Bound EC2 metadata credential retrieval separately from API request timeouts.
AWS_METADATA_SERVICE_TIMEOUT=2
AWS_METADATA_SERVICE_NUM_ATTEMPTS=1
