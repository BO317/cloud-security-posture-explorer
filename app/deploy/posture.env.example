# Replace these invented identifiers with explicit personal-lab resources.
# Do not put credentials here. Either list may be empty, but not both.
AWS_REGION=us-east-1
ALLOWED_BUCKETS=replace-with-your-lab-bucket
ALLOWED_SECURITY_GROUPS=sg-0123456789abcdef0
# Bound EC2 metadata credential retrieval separately from API request timeouts.
AWS_METADATA_SERVICE_TIMEOUT=2
AWS_METADATA_SERVICE_NUM_ATTEMPTS=1
