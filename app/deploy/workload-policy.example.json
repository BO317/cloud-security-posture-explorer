{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSelectedBucketPublicAccessBlock",
      "Effect": "Allow",
      "Action": "s3:GetBucketPublicAccessBlock",
      "Resource": ["arn:aws:s3:::replace-with-your-lab-bucket"]
    },
    {
      "Sid": "ReadEC2MetadataInSelectedRegion",
      "Effect": "Allow",
      "Action": ["ec2:DescribeSecurityGroups", "ec2:DescribeInstances", "ec2:DescribeVolumes"],
      "Resource": "*",
      "Condition": {"StringEquals": {"ec2:Region": "us-east-1"}}
    }
  ]
}
